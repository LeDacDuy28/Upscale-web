# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Model Serving (Set USE_MOCK_ENGINE=0 when .pth weights are placed in research/models/)
USE_MOCK_ENGINE=1
MODELS_DIR=./research/models
DEFAULT_TILE_SIZE=256
ENABLE_FP16=true

# Upload & Storage Policy (Work items B2, B5)
STORAGE_DIR=./webapp/backend/storage
MAX_UPLOAD_MB=20
MAX_IMAGE_DIM=4096
RETENTION_SECONDS=3600

# Queue & State (Work item B3)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
